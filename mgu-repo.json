{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "build": {
      "python": "kit/tools/build.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "network": [
        "doom"
      ],
      "shared": [
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/oapgen",
        "oap-sdk"
      ]
    }
  },
  "tools": [
    {
      "id": "idrive7-renderd",
      "path": "kit/renderd/prebuilt",
      "title": "GPU renderer",
      "description": "The apps' own GPU renderer (mgu-render): draws them at 60 fps, beside the MGU Store's Renderer; installed with the apps (iDrive 7 and iDrive 8)",
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "mgu-inputgate",
      "path": "kit/renderd/inputgate/tool",
      "title": "Controller gate",
      "description": "Lets the apps have the iDrive controller (tabs, page buttons, settings, Doom); loads into the HMI at the next start (iDrive 7 and iDrive 8)",
      "needs": [
        "renderer"
      ],
      "optional": false,
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "front-camera-cluster-helper",
      "path": "third_party/store-tools/front-camera-cluster"
    },
    {
      "id": "hotspot-studio-helper",
      "path": "third_party/store-tools/hotspot-studio-helper"
    },
    {
      "id": "vehicle-network-observer",
      "path": "third_party/store-tools/vehicle-network-observer"
    }
  ]
}
